[Unit]
Description=Exordos MetaPaaS RustFS S3 Storage
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/rustfs/data
ConditionPathExists=/etc/exordos_metapaas/rustfs.env
AssertPathIsMountPoint=/var/lib/rustfs/data

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/exordos_metapaas/rustfs.env
# Distributed endpoints are host names; they resolve through /etc/hosts
ExecStartPre=+/usr/local/bin/exordos-s3-sync-hosts
ExecStart=/usr/bin/rustfs server ${RUSTFS_VOLUMES}
ExecReload=/bin/kill -s SIGHUP $MAINPID
Restart=always
RestartSec=10s
# A cluster node waits for its peers (up to 120s by default) before it
# reports readiness
TimeoutStartSec=300s
# RustFS does not act on SIGTERM while it waits for its peers at start. Without
# SIGKILL the leftover process keeps the unit from ever starting again
TimeoutStopSec=45s
KillSignal=SIGTERM
OOMScoreAdjust=-1000
LimitNOFILE=1048576
LimitNPROC=32768
TasksMax=infinity
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
